# Copie para .env (o Makefile faz isso). Valores abaixo são EXCLUSIVAMENTE para demonstração local.
# Nunca reutilize estas senhas fora do ambiente de demonstração.

POSTGRES_USER=fachadaguard
POSTGRES_PASSWORD=fachadaguard_demo
POSTGRES_DB=fachadaguard

MQTT_DRONE_PASSWORD=drone_demo_troque
MQTT_INGESTOR_PASSWORD=ingestor_demo_troque

# Token exigido nas rotas de escrita da API (cabeçalho X-API-Token). Vazio = sem autenticação.
FG_API_TOKEN=demo-token-troque

FG_ENVIRONMENT=demo
FG_MQTT_TOPIC_PREFIX=fachadaguard/v1
FG_MQTT_QOS=1
FG_MQTT_TLS=false
FG_MAX_UPLOAD_MB=15
FG_EXPORT_INTERVAL_SECONDS=120

# IA generativa (OPCIONAL, desligada). Requer `pip install -e '.[genai]'` e chave própria.
FG_GENAI_ENABLED=false
FG_ANTHROPIC_API_KEY=
FG_GENAI_MODEL=claude-opus-5-5
